<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- app-store-connect: Auslieferung ueber TestFlight/App Store.
       Fuer lokale Geraetetests waere hier "development" richtig. -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>teamID</key>
  <string>APPLE_TEAM_ID_PLATZHALTER</string>
  <!-- Signierung ueber das in der CI eingespielte Profil, nicht automatisch:
       ein Runner hat keinen angemeldeten Xcode-Account, mit dem Apple
       automatisch ein Profil erzeugen koennte. -->
  <!-- manual: Das Archiv ist manuell mit einem App-Store-Profil signiert
       (siehe scripts/asc-profil.py). Stuende hier „automatic", versuchte der
       Export erneut automatisch zu signieren und liefe in denselben Fehler
       wie das Archivieren: kein Entwicklungsprofil ohne registriertes Geraet.
       Der Profilname wird in der CI eingesetzt — eine plist loest keine
       Variablen auf. -->
  <key>signingStyle</key>
  <string>manual</string>
  <key>provisioningProfiles</key>
  <dict>
    <key>de.skkjbeer.stackandsiege</key>
    <string>PROFILNAME_PLATZHALTER</string>
  </dict>
  <key>uploadSymbols</key>
  <true/>
  <key>compileBitcode</key>
  <false/>
</dict>
</plist>
