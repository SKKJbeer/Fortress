<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- app-store-connect: Auslieferung ueber TestFlight/App Store.
       Fuer lokale Geraetetests waere hier "development" richtig. -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>teamID</key>
  <string>APPLE_TEAM_ID_PLATZHALTER</string>
  <!-- Signierung ueber das in der CI eingespielte Profil, nicht automatisch:
       ein Runner hat keinen angemeldeten Xcode-Account, mit dem Apple
       automatisch ein Profil erzeugen koennte. -->
  <!-- automatic: xcodebuild besorgt sich Zertifikat und Profil ueber den
       App-Store-Connect-Schluessel selbst (-allowProvisioningUpdates). Mit
       "manual" muesste hier eine Zuordnung Bundle-ID -> Profilname stehen,
       und die Profildatei muesste jemand von Hand im Portal erzeugen. -->
  <key>signingStyle</key>
  <string>automatic</string>
  <key>uploadSymbols</key>
  <true/>
  <key>compileBitcode</key>
  <false/>
</dict>
</plist>
