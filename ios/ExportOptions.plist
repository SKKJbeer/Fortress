<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- app-store-connect: Auslieferung ueber TestFlight/App Store.
       Fuer lokale Geraetetests waere hier "development" richtig. -->
  <key>method</key>
  <string>app-store-connect</string>
  <key>teamID</key>
  <string>APPLE_TEAM_ID_PLATZHALTER</string>
  <!-- Signierung ueber das in der CI eingespielte Profil, nicht automatisch:
       ein Runner hat keinen angemeldeten Xcode-Account, mit dem Apple
       automatisch ein Profil erzeugen koennte. -->
  <key>signingStyle</key>
  <string>manual</string>
  <!-- Bei manueller Signierung genuegt es NICHT, das Profil in den
       Schluesselbund zu legen: exportArchive verlangt die ausdrueckliche
       Zuordnung Bundle-ID -> Profilname, sonst bricht es mit
       "No profile for bundle identifier" ab. Auch dieser Wert wird in der
       CI eingesetzt, weil eine plist keine Variablen aufloest. -->
  <key>provisioningProfiles</key>
  <dict>
    <key>de.skkjbeer.fortress</key>
    <string>PROFILNAME_PLATZHALTER</string>
  </dict>
  <key>uploadSymbols</key>
  <true/>
  <key>compileBitcode</key>
  <false/>
</dict>
</plist>
