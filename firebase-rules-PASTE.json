{
  "rules": {
    "games": {
      "ping": {
        ".read": true,
        ".write": "auth != null",
        "$other": {
          ".validate": false
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        }
      },
      "$code": {
        ".read": true,
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['createdAt'])",
        "state": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 200000)"
        },
        "guestAction2": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20000)"
        },
        "guestAction3": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 20000)"
        },
        "numPlayers": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 3"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "hb2": {
          ".validate": "newData.isNumber()"
        },
        "hb3": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "leaderboard": {
      ".read": true,
      "$playerId": {
        ".write": "auth != null && auth.uid === $playerId",
        ".validate": "newData.hasChildren(['name','wins','games'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "wappen": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "elo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "elo3": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "peakElo": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "peakElo3": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999"
        },
        "wins": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "losses": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "games": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "wins3": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "losses3": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "games3": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
        },
        "gold": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "players": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['p','updatedAt'])",
        "p": {
          ".validate": "newData.isString() && newData.val().length <= 20000"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "v": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "queue2": {
      ".read": true,
      "$ticketId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ts','status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "wappen": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "pid": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "dev": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "elo": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "hb": {
          ".validate": "newData.isNumber()"
        },
        "claimBy": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "claimTs": {
          ".validate": "newData.isNumber()"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "role": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "queue3": {
      ".read": true,
      "$ticketId": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['ts','status'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "wappen": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "color": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 60"
        },
        "pid": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "dev": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "elo": {
          ".validate": "newData.isNumber()"
        },
        "ts": {
          ".validate": "newData.isNumber()"
        },
        "hb": {
          ".validate": "newData.isNumber()"
        },
        "claimBy": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "claimTs": {
          ".validate": "newData.isNumber()"
        },
        "code": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "role": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "telemetry": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['ts','mode','rounds','per'])",
        "ts": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "v": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "mode": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "botLvl": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "rounds": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 500"
        },
        "world": {
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "winner": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "players": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3"
        },
        "per": {
          "$p": {
            ".validate": "newData.hasChildren()",
            "walls": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "cannons": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000"
            },
            "scrap": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "shots": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "hits": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "buys": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "reload": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "armor": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "repair": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "left": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000"
            },
            "alive": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "funnel": {
      ".read": true,
      "$id": {
        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['ts','schritt']) && newData.child('schritt').isString() && newData.child('schritt').val().length <= 30",
        "ts": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "wartete": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3600"
        },
        "schritt": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "art": {
          ".validate": "newData.isString() && newData.val().length <= 16"
        },
        "np": {
          ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 3"
        },
        "rolle": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3"
        },
        "auto": {
          ".validate": "newData.isBoolean()"
        },
        "ok": {
          ".validate": "newData.isBoolean()"
        },
        "fehler": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
